<footer class="footer zip-footer footer-{{ section.id }}">
  <div class="page-width">
    <div class="zip-footer__inner">
      <div class="zip-footer__top">
        <div class="zip-footer__brand">
          {%- assign footer_logo = section.settings.logo | default: settings.logo -%}
          {%- if footer_logo != blank -%}
            <a class="zip-footer__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
              {{
                footer_logo
                | image_url: width: 700
                | image_tag: widths: '180, 260, 360, 520, 700', loading: 'lazy', alt: shop.name
              }}
            </a>
          {%- elsif section.settings.show_shop_name -%}
            <a
              class="zip-footer__logo"
              href="{{ routes.root_url }}"
              style="color:inherit;font-size:30px;font-weight:800;text-decoration:none;"
            >
              {{- shop.name | escape -}}
            </a>
          {%- endif -%}

          {%- if section.settings.description != blank -%}
            <div class="zip-footer__description rte">{{ section.settings.description }}</div>
          {%- endif -%}

          {%- if section.settings.show_social -%}
            <div class="zip-footer__social">
              {%- render 'social-icons', class: 'list-social' -%}
            </div>
          {%- endif -%}
        </div>

        {%- assign menu_blocks = section.blocks | where: 'type', 'link_list' -%}
        {%- for block in menu_blocks -%}
          <nav
            class="zip-footer__menu"
            aria-label="{{ block.settings.heading | default: 'Footer' | escape }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.heading != blank -%}
              <h2 class="zip-footer__menu-title">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul class="zip-footer__menu-list">
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a href="{{ link.url }}">{{ link.title | escape }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </nav>
        {%- endfor -%}
        {%- assign app_blocks = section.blocks | where: 'type', '@app' -%}
        {%- for block in app_blocks -%}
          <div class="zip-footer__app" {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endfor -%}
      </div>

      {%- if section.settings.newsletter_enable -%}
        <div class="zip-footer__newsletter">
          <div>
            {%- if section.settings.newsletter_heading != blank -%}
              <h2 class="zip-footer__newsletter-title">{{ section.settings.newsletter_heading | escape }}</h2>
            {%- endif -%}
            {%- if section.settings.newsletter_text != blank -%}
              <div class="zip-footer__newsletter-copy rte">{{ section.settings.newsletter_text }}</div>
            {%- endif -%}
          </div>
          <div class="zip-footer__form">
            {%- form 'customer', id: 'ZipFooterNewsletter', class: 'newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="zip-footer__form-row">
                <label class="visually-hidden" for="ZipFooterEmail-{{ section.id }}">
                  {{- 'newsletter.label' | t -}}
                </label>
                <input
                  id="ZipFooterEmail-{{ section.id }}"
                  class="zip-footer__email"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  placeholder="{{ section.settings.email_placeholder | escape }}"
                  required
                >
                <button class="zip-footer__submit" type="submit">
                  {{ section.settings.newsletter_button | escape }}
                </button>
              </div>
              {%- if form.posted_successfully? -%}
                <p class="zip-footer__message" role="status">{{ 'newsletter.success' | t }}</p>
              {%- elsif form.errors -%}
                <div class="zip-footer__message" role="alert">{{ form.errors | default_errors }}</div>
              {%- endif -%}
            {%- endform -%}
          </div>
        </div>
      {%- endif -%}

      <div class="zip-footer__bottom">
        {%- assign current_year = 'now' | date: '%Y' -%}
        {%- capture copyright_line -%}{{ section.settings.copyright_text | replace: '[year]', current_year | replace: '[shop]', shop.name }}{%- endcapture -%}
        <p class="zip-footer__copyright">
          {{ copyright_line | escape }}
          {%- if section.settings.show_developer_credit -%}
            <br>
            {{ section.settings.developer_prefix | escape }}
            {%- if section.settings.developer_url != blank -%}
              <a href="{{ section.settings.developer_url }}" target="_blank" rel="noopener noreferrer">
                {{- section.settings.developer_name | escape -}}
              </a>
            {%- else -%}
              {{ section.settings.developer_name | escape }}
            {%- endif -%}
          {%- endif -%}
        </p>

        {%- if section.settings.show_policy_links and shop.policies.size > 0 -%}
          <nav class="zip-footer__policies" aria-label="{{ 'policies.general.title' | t }}">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
              {%- endif -%}
            {%- endfor -%}
          </nav>
        {%- endif -%}

        {%- if section.settings.payment_enable -%}
          <div class="zip-footer__payments">
            <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
            <ul class="list list-payment" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="list-payment__item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "ZipSeat footer",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "link_list",
      "name": "Menu column",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "SHOP"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo",
      "info": "Leave empty to use the theme logo."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 400,
      "step": 5,
      "unit": "px",
      "label": "Logo width",
      "default": 220
    },
    {
      "type": "checkbox",
      "id": "show_shop_name",
      "label": "Show store name when no logo is set",
      "default": true
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Brand description",
      "default": "<p>Power tool seat extractors for Symmons temptrol valves. Invented by a master plumber.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "Show social media icons"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "Enable newsletter signup"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Pro Tips & New Tools Drops"
    },
    {
      "type": "richtext",
      "id": "newsletter_text",
      "label": "Newsletter text"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Newsletter button label",
      "default": "Subscribe"
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show store policy links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "Show payment icons"
    },
    {
      "type": "checkbox",
      "id": "show_developer_credit",
      "label": "Show developer credit",
      "default": true
    },
    {
      "type": "text",
      "id": "developer_prefix",
      "label": "Developer credit prefix",
      "default": "Design By:"
    },
    {
      "type": "text",
      "id": "developer_name",
      "label": "Developer name",
      "default": "Thevisiontech"
    },
    {
      "type": "url",
      "id": "developer_url",
      "label": "Developer URL"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "\u00a9Copyright [year] [shop] | All Rights Reserved"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
