{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="image-text-section">
  <div class="image-text-blocks page-width">
    {% for block in section.blocks %}
      <div class="heading_image_text_item">
        {% if block.settings.text_left != blank %}
          <h2 class="image-with-text__heading inline-richtext h1">{{ block.settings.text_left }}</h2>
        {% endif %}
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.text | escape }}">
        {% endif %}
        {% if block.settings.text != blank %}
          <p>{{ block.settings.text }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>



{% schema %}
{
  "name": "Image with Text Blocks",
  "class": "heading_image_text",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Image & Text Item",
      "settings": [
        {
            "type": "text",
            "id": "text_left",
            "label": "text left"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Your text goes here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with Text Blocks",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
