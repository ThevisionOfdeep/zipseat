{%- style -%}
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;

      }



      .problem-comparison-{{ section.id }} {
        color: rgb(var(--color-foreground));
      }

      .problem-comparison-{{ section.id }}__inner {
        display: grid;
        grid-template-columns: minmax(0, 0.82fr) minmax(420px, 1.18fr);
        gap: clamp(30px, 5vw, 36px);
        align-items: start;
        padding-bottom: 50px;
        border-bottom: 2px solid #D9D9D9;
      }

      .problem-comparison-{{ section.id }}__eyebrows {
        display: flex;
        align-items: center;
        gap: 24px;
        margin-bottom: 50px;
        font-size: 18px;
        letter-spacing: 0;
        text-transform: uppercase;
        color: #535953;
        font-weight: 500;
      }

      .problem-comparison-{{ section.id }}__eyebrow-divider {
        flex: 1 1 auto;
        min-width: 24px;
        height: 1px;
        background: rgba(var(--color-foreground), 0.18);
      }

      .problem-comparison-{{ section.id }}__eyebrows > span:first-child,
      .problem-comparison-{{ section.id }}__eyebrows > span:last-child {
        min-width: 0;
        text-align: inherit;
      }

      .problem-comparison-{{ section.id }}__eyebrows > span:first-child {
        text-align: left;
      }

      .problem-comparison-{{ section.id }}__eyebrows > span:last-child {
        text-align: right;
      }

      .problem-comparison-{{ section.id }}__left {
        min-width: 0;
      }

      .problem-comparison-{{ section.id }}__heading {
        margin: 0 !important;
        max-width: 579px;
        font-size: clamp(42px, 4vw, 50px);
        line-height: 1.4;
        letter-spacing: 0;
        font-weight: 600;
        overflow-wrap: break-word;
      }

      .problem-comparison-{{ section.id }}__heading em {
        color: #397D32;
        font-style: italic;
      }

      .problem-comparison-{{ section.id }}__description {
        max-width: 530px;
        margin: 30px 0 0;
        color: #535953;
        font-size: 18px;
        line-height: 1.67;
        letter-spacing: 0;
      }

      .problem-comparison-{{ section.id }}__card {
        min-width: 0;
        background: #FFFFFF;
        color: rgb(var(--color-foreground));
        padding: 30px 30px 30px;
      }

      .problem-comparison-{{ section.id }}__card-header {
        display: flex;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 30px;
        font-size: 16px;
        letter-spacing: 0;
        font-weight: 500;
        color: #535953;
        text-transform: uppercase;
      }

      .problem-comparison-{{ section.id }}__row {
        display: grid;
        grid-template-columns: minmax(150px, 220px) minmax(140px, 1fr) 96px;
        align-items: center;
        gap: 20px;
      }

      .problem-comparison-{{ section.id }}__row + .problem-comparison-{{ section.id }}__row {
        border-top: 1px dashed rgba(var(--color-foreground), 0.2);
        margin-top: 20px;
        padding-top: 20px;
      }

      .problem-comparison-{{ section.id }}__method-name {
        margin: 0 0 8px;
        font-size: 20px;
        font-weight: 700;
        line-height: 1.15;
        letter-spacing: 0;
      }

      .problem-comparison-{{ section.id }}__method-detail {
        color: #535953;
        font-size: 12px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .problem-comparison-{{ section.id }}__track {
        height: 28px;
        overflow: hidden;
        background: rgba(var(--color-foreground), 0.08);
        font-size: 0;
        line-height: 0;
      }

      .problem-comparison-{{ section.id }}__time {
        text-align: right;
        color: var(--comparison-color);
        font-size: 34px;
        font-weight: 700;
        font-style: italic;
        line-height: 1;
        letter-spacing: 0;
      }

      .problem-comparison-{{ section.id }}__card-footer {
        margin: 30px 0 0;
        color: #535953;
        font-size: 14px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-weight: 500;
      }

      @media screen and (min-width: 750px) {
        .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top }}px;
          padding-bottom: {{ section.settings.padding_bottom }}px;
        }
      }

      @media (min-width: 1440px) and (max-width: 1600px) {
        .problem-comparison-{{ section.id }}__inner {
          gap: 28px;
        }

        .problem-comparison-{{ section.id }}__heading {
          max-width: 500px;
          font-size: 40px;
        }

        .problem-comparison-{{ section.id }}__eyebrows {
          margin-bottom: 40px;
          font-size: 16px;
        }

        .problem-comparison-{{ section.id }}__description {
          margin: 26px 0 0;
          font-size: 16px;
        }

        .problem-comparison-{{ section.id }}__card {
          padding: 26px;
        }

        .problem-comparison-{{ section.id }}__card-header {
          margin-bottom: 26px;
          font-size: 15px;
        }

        .problem-comparison-{{ section.id }}__method-name {
          font-size: 18px;
        }

        .problem-comparison-{{ section.id }}__method-detail {
          font-size: 11px;
        }

        .problem-comparison-{{ section.id }}__track {
          height: 24px;
        }

        .problem-comparison-{{ section.id }}__time {
          font-size: 30px;
        }

        .problem-comparison-{{ section.id }}__card-footer {
          margin: 26px 0 0;
          font-size: 13px;
        }

        .problem-comparison-{{ section.id }}__row + .problem-comparison-{{ section.id }}__row {
          margin-top: 18px;
          padding-top: 18px;
        }
      }

      @media (min-width: 1200px) and (max-width: 1439.99px) {
        .problem-comparison-{{ section.id }}__card{
          padding: 20px;
        }
        .problem-comparison-{{ section.id }}__heading {
            font-size: 36px;
            line-height: 1.32;
            max-width: 35rem;
          }
          .problem-comparison-{{ section.id }}__eyebrows{
            font-size: 14px;
            gap: 16px;
            margin-bottom: 40px;
          }
          .problem-comparison-{{ section.id }}__description{
            font-size: 14px;
            margin: 20px 0;
          }
           .problem-comparison-{{ section.id }}__card-header

            {
            font-size: 14px;
            margin-bottom: 25px;
          }
          .problem-comparison-{{ section.id }}__method-name{
            font-size: 16px;
            margin-bottom: 6px ;
          }
          .problem-comparison-{{ section.id }}__method-detail{
             font-size: 10px;
          }
          .problem-comparison-{{ section.id }}__card-footer
            {
            font-size: 14px;
             margin-top: 25px;
          }
           .problem-comparison-{{ section.id }}__time{
              font-size: 28px;
           }
            .problem-comparison-{{ section.id }}__row {
              gap: 16px;
            }
           .problem-comparison-{{ section.id }}__row + .problem-comparison-{{ section.id }}__row
            {
            margin-top: 16px;
            padding-top: 16px;
          }



      }

    @media (min-width: 989px) and (max-width: 1200px)
      {
       .problem-comparison-{{ section.id }}__inner{
         padding-bottom: 40px;
        }
        .problem-comparison-{{ section.id }}__card{
          padding: 16px;
        }
        .problem-comparison-{{ section.id }}__heading {
            font-size: 36px;
             line-height: 1.2;
             max-width: 40rem;
          }
          .problem-comparison-{{ section.id }}__eyebrows{
            font-size: 14px;
            gap: 14px;
            margin-bottom: 35px;
          }
          .problem-comparison-{{ section.id }}__description{
            font-size: 14px;
            margin: 14px 0;
            line-height: 1.79;
          }
           .problem-comparison-{{ section.id }}__card-header

            {
            font-size: 14px;
            margin-bottom: 20px;
          }
          .problem-comparison-{{ section.id }}__method-name{
            font-size: 16px;
            margin-bottom: 4px ;
          }
          .problem-comparison-{{ section.id }}__method-detail{
             font-size: 10px;
          }
          .problem-comparison-{{ section.id }}__card-footer
            {
            font-size: 14px;
             margin-top: 20px;
          }
           .problem-comparison-{{ section.id }}__time{
              font-size: 28px;
           }
            .problem-comparison-{{ section.id }}__row {
              grid-template-columns: minmax(150px, 180px) minmax(100px, 1fr) 80px;
              gap: 12px;
            }
           .problem-comparison-{{ section.id }}__row + .problem-comparison-{{ section.id }}__row
            {
            margin-top: 16px;
            padding-top: 16px;
          }
   }

    @media (min-width: 749px) and (max-width: 989px) {
        .problem-comparison-{{ section.id }}__inner {
          grid-template-columns: 1fr;
          gap: 30px;
          }

        .problem-comparison-{{ section.id }}__left,
        .problem-comparison-{{ section.id }}__heading {
          max-width:90%;
        }

        .problem-comparison-{{ section.id }}__eyebrows {
          margin-bottom: 25px;
          font-size: 12px;
        }
         .problem-comparison-{{ section.id }}__heading {
      font-size: 30px;
       line-height: 1.2;
       max-width: 30rem;
    }
     .problem-comparison-{{ section.id }}__description{
      margin-top: 20px;
     }

    .problem-comparison-{{ section.id }}__row {
      grid-template-columns: minmax(180px, 220px) minmax(140px, 1fr) 96px;
    }
    }





     @media screen and (max-width: 749px) {
         .section-{{ section.id }}-padding {
      padding-top: 50px;
    }
         .problem-comparison-{{ section.id }}__inner {
          grid-template-columns: 1fr;
          gap: 24px;
          padding-bottom: 36px;
          }
        .problem-comparison-{{ section.id }}__eyebrows {
          margin-bottom: 30px;
        }

        .problem-comparison-{{ section.id }}__eyebrows {
          gap: 8px;
          font-size: clamp(9px, 2.7vw, 12px);
          margin-bottom: 30px;
        }

        .problem-comparison-{{ section.id }}__eyebrow-divider {
          min-width: 12px;
        }

        .problem-comparison-{{ section.id }}__heading {
          font-size: 30px;
          line-height: 1.2;
          max-width: 30rem;
        }

        .problem-comparison-{{ section.id }}__description {
          margin-top: 16px;
          font-size: 16px;
          line-height: 1.55;
        }

        .problem-comparison-{{ section.id }}__card {
          padding: 22px 18px;
        }

        .problem-comparison-{{ section.id }}__row {
          grid-template-columns: 1fr 74px;
        }

        .problem-comparison-{{ section.id }}__track {
          grid-column: 1 / -1;
          grid-row: 2;
          height: 18px;
        }

        .problem-comparison-{{ section.id }}__time {
          grid-column: 2;
          grid-row: 1;
          font-size: 24px;
        }

        .problem-comparison-{{ section.id }}__card-footer {
          margin-top: 20px;
          line-height: 1.6;
          letter-spacing: 0.05em;
        }
        .problem-comparison-{{ section.id }}__card-header{
          gap: 20px;
          margin-bottom: 20px;
        }
        .problem-comparison-{{ section.id }}__method-name{
          margin-bottom: 6px;
        }


  }

  @media screen and (max-width: 449px){
 
     .problem-comparison-{{ section.id }}__eyebrow-divider {
          min-width: 8px;

        }
       .problem-comparison-{{ section.id }}__eyebrows {
        margin-bottom: 25px;
        font-size: 12px;
      }
      .problem-comparison-{{ section.id }}__card-header {
        align-items: flex-start;
        flex-direction: column;
        gap: 6px;
      }
      .problem-comparison-{{ section.id }}__heading {
        font-size: 24px;
        line-height: 1.35;
      }
       .problem-comparison-{{ section.id }}__card-footer {

          letter-spacing: 0.02em;
        }
  }
{%- endstyle -%}

<section class="color-{{ section.settings.color_scheme }} gradient problem-comparison-{{ section.id }} section-{{ section.id }}-padding ">
  <div class="page-width">
    <div class="problem-comparison-{{ section.id }}__eyebrows">
      <span>{{ section.settings.left_label | escape }}</span>
      <span class="problem-comparison-{{ section.id }}__eyebrow-divider" aria-hidden="true"></span>
      <span>{{ section.settings.right_label | escape }}</span>
    </div>

    <div class="problem-comparison-{{ section.id }}__inner  problem-comparison-section">
      <div class="problem-comparison-{{ section.id }}__left">
        {% if section.settings.heading != blank %}
          {%- assign heading = section.settings.heading | escape | replace: 'barbaric', '<em>barbaric</em>' -%}
          <h2 class="problem-comparison-{{ section.id }}__heading {{ section.settings.heading_tag }}">{{ heading }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="problem-comparison-{{ section.id }}__description rte">{{ section.settings.description }}</div>
        {% endif %}
      </div>

      <div class="problem-comparison-{{ section.id }}__card">
        <div class="problem-comparison-{{ section.id }}__card-header">
          <span>{{ section.settings.comparison_title | escape }}</span>
          <span>{{ section.settings.unit_label | escape }}</span>
        </div>

        {% for block in section.blocks %}
          {%- assign bar_width = block.settings.bar_width | default: 100 -%}
          {%- assign bar_color = block.settings.bar_color | default: block.settings.text_color -%}
          <div
            class="problem-comparison-{{ section.id }}__row"
            style="--comparison-color: {{ block.settings.text_color }};"
            {{ block.shopify_attributes }}
          >
            <div>
              {% if block.settings.name != blank %}
                <h3 class="problem-comparison-{{ section.id }}__method-name">{{ block.settings.name | escape }}</h3>
              {% endif %}
              {% if block.settings.detail != blank %}
                <div class="problem-comparison-{{ section.id }}__method-detail">
                  {{ block.settings.detail | escape }}
                </div>
              {% endif %}
            </div>

            <div
              class="problem-comparison-{{ section.id }}__track"
              style="background-image: linear-gradient(to right, {{ bar_color }} 0%, {{ bar_color }} {{ bar_width }}%, rgba(var(--color-foreground), 0.08) {{ bar_width }}%, rgba(var(--color-foreground), 0.08) 100%);"
            >
              &nbsp;
            </div>

            {% if block.settings.time != blank %}
              <div class="problem-comparison-{{ section.id }}__time">{{ block.settings.time | escape }}</div>
            {% endif %}
          </div>
        {% endfor %}

        {% if section.settings.footer_text != blank %}
          <p class="problem-comparison-{{ section.id }}__card-footer">{{ section.settings.footer_text | escape }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Problem comparison",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "left_label",
      "label": "Left eyebrow",
      "default": "The problem"
    },
    {
      "type": "text",
      "id": "right_label",
      "label": "Right eyebrow",
      "default": "Hand tools vs. Zip Seat"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Still fighting symmons seats with barbaric hand tools?"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading size",
      "default": "h1",
      "options": [
        { "value": "h1", "label": "Extra large" },
        { "value": "h2", "label": "Large" },
        { "value": "h3", "label": "Medium" }
      ]
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Hand seat wrenches round off, strip soft brass and push torque through the plumbing. That complicates the rebuild and cuts the valve out of the wall.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "comparison_title",
      "label": "Comparison title",
      "default": "Time to break one seized seat free"
    },
    {
      "type": "text",
      "id": "unit_label",
      "label": "Unit label",
      "default": "MM : SS"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Typical: badly seized seats can take 5 sec - 2 min with an 18V impact."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "comparison",
      "name": "Comparison method",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Method name",
          "default": "Hand seat wrench"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Method detail",
          "default": "Leverage + easy-out"
        },
        {
          "type": "text",
          "id": "time",
          "label": "Time",
          "default": "15:00+"
        },
        {
          "type": "range",
          "id": "bar_width",
          "label": "Bar width",
          "min": 5,
          "max": 100,
          "step": 5,
          "default": 95,
          "unit": "%"
        },
        {
          "type": "color",
          "id": "bar_color",
          "label": "Bar color",
          "default": "#d94b4b"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Time color",
          "default": "#d94b4b"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Problem comparison",
      "category": "Custom Sections",
      "blocks": [
        {
          "type": "comparison",
          "settings": {
            "name": "Hand seat wrench",
            "detail": "Leverage + easy-out",
            "time": "15:00+",
            "bar_width": 100,
            "bar_color": "#d94b4b",
            "text_color": "#d94b4b"
          }
        },
        {
          "type": "comparison",
          "settings": {
            "name": "Zip Seat + impact",
            "detail": "18V impact driver",
            "time": "00:15",
            "bar_width": 5,
            "bar_color": "#64B656",
            "text_color": "#64B656"
          }
        }
      ]
    }
  ]
}
{% endschema %}
